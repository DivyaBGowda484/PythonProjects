#Calculator app using tkinter

import tkinter as tk
from tkinter import messagebox
import math

# Function to append the pressed key to the input field
def press(key):
    entry.insert(tk.END, key)

# Function to clear the input field
def clear():
    entry.delete(0, tk.END)

# Function to evaluate the mathematical expression
def equal():
    try:
        expression = entry.get()  # Get the current expression
        result = eval(expression)  # Evaluate the expression
        entry.delete(0, tk.END)    # Clear the entry
        entry.insert(tk.END, result)  # Display the result
    except ZeroDivisionError:
        messagebox.showerror("Error", "Division by zero is not allowed.")
        clear()  # Clear the entry if error occurs
    except Exception:
        messagebox.showerror("Error", "Invalid input.")
        clear()  # Clear the entry for any other errors

# Function to calculate square of the input
def square():
    try:
        num = float(entry.get())  # Convert input to float
        result = num ** 2         # Calculate square
        entry.delete(0, tk.END)
        entry.insert(tk.END, result)
    except Exception:
        messagebox.showerror("Error", "Invalid input.")
        clear()

# Function to calculate square root of the input
def square_root():
    try:
        num = float(entry.get())  # Convert input to float
        if num < 0:
            raise ValueError("Negative input")  # Raise error for negative numbers
        result = math.sqrt(num)   # Calculate square root
        entry.delete(0, tk.END)
        entry.insert(tk.END, result)
    except:
        messagebox.showerror("Error", "Cannot calculate square root of negative number.")
        clear()

# Create the main application window
root = tk.Tk()
root.title("Python Calculator")        # Set window title
root.geometry("400x500")               # Set window size
root.resizable(False, False)           # Disable window resizing

# Create an entry widget for input and output
entry = tk.Entry(root, font=("Arial", 20), bd=10, insertwidth=2, width=14, borderwidth=4, justify='right')
entry.grid(row=0, column=0, columnspan=4, pady=20)  # Place it on the grid

# Define button texts and positions (row, column)
buttons = [
    ('7', 1, 0), ('8', 1, 1), ('9', 1, 2), ('+', 1, 3),
    ('4', 2, 0), ('5', 2, 1), ('6', 2, 2), ('-', 2, 3),
    ('1', 3, 0), ('2', 3, 1), ('3', 3, 2), ('*', 3, 3),
    ('0', 4, 0), ('.', 4, 1), ('%', 4, 2), ('/', 4, 3),
]

# Create and place all buttons in the grid
for (text, row, col) in buttons:
    tk.Button(root, text=text, padx=20, pady=20, font=("Arial", 14), command=lambda t=text: press(t)).grid(row=row, column=col)

# Create and place special function buttons in the bottom row
tk.Button(root, text="C", padx=20, pady=20, font=("Arial", 14), bg="orange", command=clear).grid(row=5, column=0)
tk.Button(root, text="x²", padx=20, pady=20, font=("Arial", 14), command=square).grid(row=5, column=1)
tk.Button(root, text="√", padx=20, pady=20, font=("Arial", 14), command=square_root).grid(row=5, column=2)
tk.Button(root, text="=", padx=20, pady=20, font=("Arial", 14), bg="lightgreen", command=equal).grid(row=5, column=3)

# Start the Tkinter main event loop
root.mainloop()
